rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'ucDDWXGYaePSxf1pvU5LL8IOZ5B3';
    }
    function isMe(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /chats/{uid} {
      allow read: if isAdmin() || isMe(uid);
      allow write: if (isAdmin() || isMe(uid)) && request.resource.size() < 200000;
      match /admin/state {
        allow read, write: if isAdmin() || isMe(uid);
      }
    }
  }
}
